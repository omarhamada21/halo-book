# Server Configuration
PORT=3000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_here

# Google AI (Gemini) API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Administrator & Root Access
ROOT_EMAIL=admin@example.com
ADMIN_EMAIL=teacher_admin@example.com

# SMTP Email Configuration (for notifications & password reset)
SMTP_EMAIL=your_smtp_email@example.com
SMTP_PASSWORD=your_smtp_app_password

# Database (Turso / LibSQL Cloud or local SQLite)
# For local development: file:mimirmarking.db
# For production: libsql://<database-name>.turso.io
TURSO_DATABASE_URL=file:mimirmarking.db
TURSO_AUTH_TOKEN=

# S3 / Filebase Storage (Optional, falls back to local disk storage)
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET_NAME=
FILEBASE_ENDPOINT=https://s3.filebase.com